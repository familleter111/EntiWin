# MySQL connection. In Azure this points at the "entiwin" database on an
# Azure Database for MySQL Flexible Server (see DEPLOY.md); locally it points
# at the `db` service in docker-compose.yml.
DATABASE_URL=mysql://entiwin:entiwin@db:3306/entiwin
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=entiwin
MYSQL_USER=entiwin
MYSQL_PASSWORD=entiwin
# Azure Database for MySQL Flexible Server enforces TLS by default.
MYSQL_SSL=true
